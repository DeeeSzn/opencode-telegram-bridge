# ---------------------------------------------------------------- Telegram ---
# Bot token from @BotFather. Required for both the MCP server and the bridge.
TELEGRAM_BOT_TOKEN=

# Your own chat ID. After messaging the bot, stop any bridge poller and run:
#   python3 scripts/get_chat_id.py
TELEGRAM_DEFAULT_CHAT_ID=

# Who may drive the agent. Comma separated; every intended chat must be listed
# explicitly. An empty list blocks all chats.
TELEGRAM_ALLOWED_CHAT_IDS=

# Per-chat rate limit for inbound messages.
# TELEGRAM_RATE_LIMIT_COUNT=20
# TELEGRAM_RATE_LIMIT_WINDOW=60

# Longest inbound message accepted (characters).
# TELEGRAM_MAX_MESSAGE_LENGTH=8000

# ---------------------------------------------------------------- OpenCode ---
# The OpenCode server. Must be loopback: it ships without authentication.
OPENCODE_URL=http://127.0.0.1:4096

# Set these if you secured the OpenCode server with a password.
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# --------------------------------------------------------------- Behaviour ---
# Where the chat -> session binding is stored.
# OC_TELEGRAM_STATE_DIR=~/.opencode_telegram

# How long to wait for the agent before giving up (seconds).
# OC_TELEGRAM_RESPONSE_TIMEOUT=600

# Dedicated directory for files that telegram_send_document may upload.
# Do not point this at the repository root or a home directory.
# OC_TELEGRAM_MEDIA_ROOT=

# DEBUG | INFO | WARNING | ERROR
# OC_TELEGRAM_LOG_LEVEL=INFO
